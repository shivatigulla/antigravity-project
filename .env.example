# Environment Configuration Example
PORT=5001
NODE_ENV=development

# Optional: External PostgreSQL connection string.
# If omitted, the app automatically uses embedded persistent PGlite in ./data/postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/household_finance_db

# Google Gemini API Key for AI Financial Auditing
# Can also be entered securely via the /settings page in the UI
GEMINI_API_KEY=your_gemini_api_key_here
